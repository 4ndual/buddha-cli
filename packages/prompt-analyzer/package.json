{
	"type": "module",
	"private": true,
	"name": "@oh-my-pi/prompt-analyzer",
	"version": "0.0.1",
	"description": "Buddha live prompt analyzer — two-window dev tool that visualizes a prompt's paraphrase/categorize/analyze/verify pipeline as it streams",
	"homepage": "https://github.com/4ndual/buddha-cli",
	"author": "Stencil Labs, Inc.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/4ndual/buddha-cli.git",
		"directory": "packages/prompt-analyzer"
	},
	"bin": {
		"prompt-analyzer": "src/main.ts"
	},
	"scripts": {
		"start": "bun run src/main.ts",
		"dev": "bun --hot src/main.ts",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"test": "bun test",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"dependencies": {
		"@oh-my-pi/pi-coding-agent": "catalog:",
		"@oh-my-pi/pi-utils": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"puppeteer-core": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
