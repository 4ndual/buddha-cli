#!/bin/sh
# Dev launcher for the Buddha CLI, installed by `bun run setup`.
#
# Bun reads `bunfig.toml` from the current working directory before running a
# script. Launching from an empty directory prevents unrelated project preloads
# from contaminating Buddha, then the preload shim restores the caller's cwd.
set -e

# Resolve this script's real location even when invoked through a symlink
# (`$HOME/.bun/bin/buddha` -> this file).
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
cli=$scripts_dir/../src/cli.ts
preload=$scripts_dir/omp.ts
timing_preload=$scripts_dir/../../utils/src/module-timer.ts

launch_dir=${BUDDHA_DEV_LAUNCH_DIR:-${HOME}/.buddha/.dev-cwd}
mkdir -p "$launch_dir"

OMP_LAUNCH_CWD=$PWD
export OMP_LAUNCH_CWD
cd "$launch_dir"
# Herdr validates the foreground process name on macOS.
run_bun() {
	if [ "${HERDR_ENV:-}" = 1 ] && [ "$(uname -s)" = Darwin ]; then
		exec -a buddha bun "$@"
	fi
	exec bun "$@"
}

if [ -n "${PI_TIMING:-}" ]; then
	run_bun --preload "$preload" --preload "$timing_preload" "$cli" "$@"
fi
run_bun --preload "$preload" "$cli" "$@"
